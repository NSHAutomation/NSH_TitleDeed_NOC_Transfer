 If CDbl(shorter.Count) / CDbl(longer.Count) &lt; 0.5 Then Return False&#xA;    Return shorter.All(Function(w) longer.Any(Function(x) wordEq(w, x)))&#xA;End Function&#xA;&#xA;' ---------- Full match: every owner has a party AND every party has an owner ----------&#xA;out_IsFullMatch = False&#xA;&#xA;If in_dt_Owners.Rows.Count &gt; 0 AndAlso in_dt_CaseParties.Rows.Count &gt; 0 Then&#xA;    Dim allOwnersFound As Boolean = True&#xA;    For Each o As DataRow In in_dt_Owners.Rows&#xA;        Dim found As Boolean = False&#xA;        For Each p As DataRow In in_dt_CaseParties.Rows&#xA;            If nameMatch(o(&quot;Owner Names&quot;).ToString(), p(&quot;Related Account&quot;).ToString()) Then&#xA;                found = True&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;        If Not found Then&#xA;            allOwnersFound = False&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;&#xA;    Dim allPartiesFound As Boolean = True&#xA;    If allOwnersFound Then&#xA;        For Each p As DataRow In in_dt_CaseParties.Rows&#xA;            Dim found As Boolean = False&#xA;            For Each o As DataRow In in_dt_Owners.Rows&#xA;                If nameMatch(o(&quot;Owner Names&quot;).ToString(), p(&quot;Related Account&quot;).ToString()) Then&#xA;                    found = True&#xA;                    Exit For&#xA;                End If&#xA;            Next&#xA;            If Not found Then&#xA;                allPartiesFound = False&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;    End If&#xA;&#xA;    out_IsFullMatch = allOwnersFound AndAlso allPartiesFound&#xA;End If" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="452,403" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
